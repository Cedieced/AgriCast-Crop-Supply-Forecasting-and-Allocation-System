{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start AgriCast API",
            "type": "shell",
            "command": "npm.cmd",
            "args": [
                "run",
                "dev",
                "--",
                "--open"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\backend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> .* dev$",
                    "endsPattern": "^Crop Supply API listening on http://localhost:4000$"
                }
            }
        },
        {
            "label": "Start AgriCast Web",
            "type": "shell",
            "command": "npm.cmd",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> .* dev$",
                    "endsPattern": "^\\s*.*Local:\\s+http://localhost:5173/$"
                }
            }
        },
        {
            "label": "Start AgriCast Field App in Chrome",
            "type": "shell",
            "command": "flutter",
            "args": [
                "run",
                "-d",
                "chrome",
                "--web-port",
                "5174"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\mobile"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching lib\\\\main.dart on Chrome in debug mode",
                    "endsPattern": "^Flutter run key commands\\.$"
                }
            }
        },
        {
            "label": "Start AgriCast Services",
            "dependsOn": [
                "Start AgriCast API",
                "Start AgriCast Web",
                "Start AgriCast Field App in Chrome"
            ],
            "dependsOrder": "parallel"
        },
        {
            "label": "Start AgriCast Dashboard on Folder Open",
            "dependsOn": [
                "Start AgriCast API",
                "Start AgriCast Web"
            ],
            "dependsOrder": "sequence",
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
